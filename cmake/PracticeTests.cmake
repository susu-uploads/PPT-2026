include(CTest)

if(NOT BUILD_TESTING)
  return()
endif()

add_executable(verify verify.cpp)
target_compile_options(verify PRIVATE -Wall -Wextra -Wpedantic)
target_include_directories(verify PRIVATE "${CMAKE_CURRENT_LIST_DIR}")

function(add_program_test name target)
  cmake_parse_arguments(PARSE_ARGV 2 case "" "INPUT;PROCESSES;THREADS;EXIT_CODE" "ARGS;CHECK")
  list(REMOVE_ITEM case_KEYWORDS_MISSING_VALUES ARGS)
  if(case_UNPARSED_ARGUMENTS OR case_KEYWORDS_MISSING_VALUES OR NOT case_CHECK)
    message(FATAL_ERROR "Invalid test definition: ${name}")
  endif()
  if(NOT DEFINED case_EXIT_CODE)
    set(case_EXIT_CODE 0)
  endif()
  if(NOT DEFINED case_THREADS)
    set(case_THREADS 4)
  endif()

  set(command "$<TARGET_FILE:${target}>")
  if(case_PROCESSES)
    if(NOT MPIEXEC_EXECUTABLE OR NOT MPIEXEC_NUMPROC_FLAG)
      message(FATAL_ERROR "MPI launcher is required for ${name}")
    endif()
    set(command "${MPIEXEC_EXECUTABLE}" "${MPIEXEC_NUMPROC_FLAG}" "${case_PROCESSES}"
      ${MPIEXEC_PREFLAGS} --bind-to none "$<TARGET_FILE:${target}>" ${MPIEXEC_POSTFLAGS})
  endif()
  if(case_ARGS)
    string(APPEND command ";${case_ARGS}")
  endif()
  set(check_command "$<TARGET_FILE:verify>;${case_CHECK}")
  set(directory "${CMAKE_CURRENT_BINARY_DIR}/test-data/${name}/$<CONFIG>")
  file(GENERATE OUTPUT "${directory}/stdin.txt" CONTENT "${case_INPUT}")
  file(GENERATE OUTPUT "${directory}/case.cmake" CONTENT
"set(PROGRAM_COMMAND [==[${command}]==])
set(CHECK_COMMAND [==[${check_command}]==])
set(EXPECTED_EXIT ${case_EXIT_CODE})
set(CASE_DIRECTORY [==[${directory}]==])
")
  add_test(NAME "${name}" COMMAND "${CMAKE_COMMAND}"
    "-DCASE_FILE=${directory}/case.cmake"
    -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunProgramTest.cmake")
  set_tests_properties("${name}" PROPERTIES TIMEOUT 40
    ENVIRONMENT "OMP_DYNAMIC=FALSE;OMP_NUM_THREADS=${case_THREADS}")
endfunction()

function(matrix_case n input_name expected_name)
  set(input "${n}\n")
  set(expected)
  math(EXPR last "${n} * ${n}")
  foreach(value RANGE 1 ${last})
    string(APPEND input "${value} ")
    list(APPEND expected "${value}")
  endforeach()
  math(EXPR last_index "${n} - 1")
  foreach(i RANGE 0 ${last_index})
    foreach(j RANGE 0 ${last_index})
      if(i EQUAL j)
        string(APPEND input "1 ")
      else()
        string(APPEND input "0 ")
      endif()
    endforeach()
  endforeach()
  string(APPEND input "\n")
  set(${input_name} "${input}" PARENT_SCOPE)
  set(${expected_name} "${expected}" PARENT_SCOPE)
endfunction()
